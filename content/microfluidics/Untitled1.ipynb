   "source": [
    "fc=1e3\n",
    "fm=50.\n",
    "t=np.linspace(0.,3./fm,int(1e4))\n",
    "si1=(1.+np.sin(2.*np.pi*fm*t))*np.sin(2.*np.pi*fc*t)\n",
    "si2=(np.sin(2.*np.pi*fm*t))*np.sin(2.*np.pi*fc*t)\n",
    "\n",
    "plt.plot(t,si1,t,si2);"
   ]
